# الدرجة العظمى لكل مهمة
MAX_SCORES = [10, 20, 30, 15, 20]

def generate_human_score(max_score, is_dropout, task_index):
    """توليد درجة بشرية واقعية تتفاوت من طالب لآخر"""
    if is_dropout and task_index > 1:
        return 0 # المتسرب يأخذ أصفاراً بعد المهمة الثانية
    
    if is_dropout and task_index <= 1:
        # المتسرب في البداية كان أداؤه ضعيفاً
        base = random.uniform(0.4, 0.6) * max_score
    else:
        # الطالب الطبيعي أداؤه بين الجيد جداً والممتاز (مع تفاوت)
        base = random.triangular(0.65, 1.0, 0.85) * max_score
        
    return int(round(base))

def apply_late_penalty(score, delay_hours):
    """تطبيق لوائح الخصم بصرامة للمتأخرين (G2 و G4)"""
    if delay_hours <= 0: return score # تسليم في الموعد أو قبله
    if 0 < delay_hours <= 6: return int(score * 0.70) # خصم 30%
    if 6 < delay_hours <= 24: return int(score * 0.40) # خصم 60%
    return 0 # تأخير أكثر من 24 ساعة = صفر

def generate_human_timestamp(group, task_index, is_dropout):
    """توليد وقت تسليم يعكس الطبيعة البشرية (تأخير، تسويف، أو التزام)"""
    if is_dropout and task_index > 1:
        return "لم يتم التسليم", 0

    if group in ["G2", "G4"]:
        # ⚡ الضغط الزمني:
        deadline_day = DEADLINES[group][task_index]
        deadline_time = START_DATE + timedelta(days=deadline_day)
        deadline_time = deadline_time.replace(hour=23, minute=59, second=0)

        # التوزيع البشري للتسليم: معظمهم قبل الموعد بـ 2 إلى 10 ساعات، والبعض يتأخر
        # استخدام التوزيع الطبيعي (Mean = -4 hours, StdDev = 5 hours)
        delay_hours = random.gauss(-4, 5) 
        
        # تجنب التسليم في أوقات الفجر (من 2 صباحاً لـ 8 صباحاً)
        actual_submit = deadline_time + timedelta(hours=delay_hours)
        if 2 <= actual_submit.hour <= 8:
            actual_submit -= timedelta(hours=7) # إرجاعه للمساء السابق
            delay_hours -= 7

        str_time = actual_submit.strftime("%Y-%m-%d %H:%M")
        return str_time, delay_hours

    else:
        # 🌿 الوقت المفتوح (G1, G3):
        # يميلون للتسويف (Procrastination)، التسليم يتأخر نحو الأيام الأخيرة
        if task_index == 4: # المهمة الأخيرة دائماً في اليوم 20 أو 21
            submit_day = random.uniform(19, 20.9)
        else:
            # مهام أخرى تسلم بشكل مبعثر
            min_day = task_index * 3
            max_day = 20.5
            submit_day = random.triangular(min_day, max_day, max_day - 2)
        
        actual_submit = START_DATE + timedelta(days=submit_day)
        if 2 <= actual_submit.hour <= 8: actual_submit -= timedelta(hours=8)
        
        return actual_submit.strftime("%Y-%m-%d %H:%M"), 0

