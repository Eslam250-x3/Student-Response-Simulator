    # إضافة تذبذب بشري بسيط (Noise) على مهارة الطالب الحقيقية
    actual_perf = student_skill + random.gauss(0, 0.05)
    actual_perf = max(0.2, min(1.0, actual_perf))

    # تأثير بيئة العمل (التشاركي يرفع الجودة قليلاً، التنافسي المضغوط يقللها قليلاً)
    if group == "G3": actual_perf = min(1.0, actual_perf + 0.05)
    elif group == "G2": actual_perf = max(0.1, actual_perf - 0.05)

    return int(round(actual_perf * max_score))

def apply_late_penalty(score, delay_hours):
    """تطبيق لوائح الخصم بصرامة للمتأخرين"""
    if delay_hours <= 0: return score
    if 0 < delay_hours <= 6: return int(score * 0.70) # خصم 30%
    if 6 < delay_hours <= 24: return int(score * 0.40) # خصم 60%
    return 0

def generate_anchored_timestamp(group, task_index, is_dropout, student_flow):
    """توليد وقت تسليم يعتمد حرفياً على مستوى التدفق الذهني للطالب"""
    if is_dropout and task_index > 1: return "لم يتم التسليم", 0

    if group in ["G2", "G4"]:
        # ⚡ الضغط الزمني:
        deadline_day = DEADLINES[group][task_index]
        deadline_time = START_DATE + timedelta(days=deadline_day)
        deadline_time = deadline_time.replace(hour=23, minute=59, second=0)

        # 🎯 الربط بالتدفق: 
        # تدفق عالي (0.8) -> يسلم مبكراً جداً (سالب)
        # تدفق منخفض (0.3) -> يسلم متأخراً أو على الحافة (موجب أو صفر)
        expected_delay = 5 - (student_flow * 15) 
        delay_hours = random.gauss(expected_delay, 3) 
        
        actual_submit = deadline_time + timedelta(hours=delay_hours)
        if 2 <= actual_submit.hour <= 8: actual_submit -= timedelta(hours=7)
        return actual_submit.strftime("%Y-%m-%d %H:%M"), delay_hours

    else:
        # 🌿 الوقت المفتوح:
        # 🎯 الربط بالتدفق: التدفق المنخفض يعني تسويف (Procrastination) وتأجيل للأيام الأخيرة
        if task_index == 4:
            submit_day = random.uniform(20, 20.9)
        else:
            procrastination_factor = (1 - student_flow) * 6 # كلما قل التدفق، زاد التأجيل
            base_day = (task_index * 3) + procrastination_factor
            submit_day = min(20.5, base_day + random.uniform(-1, 2))
            
        actual_submit = START_DATE + timedelta(days=submit_day)
        if 2 <= actual_submit.hour <= 8: actual_submit -= timedelta(hours=8)
        return actual_submit.strftime("%Y-%m-%d %H:%M"), 0

