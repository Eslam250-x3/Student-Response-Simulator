// =========================================================================
// 🧠 نظام الطابور الذكي (Smart Queue) - لضمان فرق الساعتين للطالب الواحد
// =========================================================================

/**
 * 📅 1. بناء وجدولة الطابور للاختبار القبلي (MCQ + التدفق)
 */
function buildQueue_PreTest() {
    var data = loadSimulationData();
    var students = data.students;
    var queue = [];
    var now = new Date().getTime();

    // توزيع إرسال الطلاب عشوائياً على مدار 48 ساعة من الآن 
    var windowMs = 48 * 60 * 60 * 1000; 

    for (var i = 0; i < students.length; i++) {
        var student = students[i];

        // 1. تحديد وقت عشوائي للاختبار المعرفي خلال الـ 48 ساعة
        var mcqTime = now + (Math.random() * windowMs);

        // 2. تحديد وقت مقياس التدفق (موعد المعرفي + ساعتين ± 30 دقيقة عشوائية للتمويه)
        var twoHoursMs = 2 * 60 * 60 * 1000;
        var randomVariation = (Math.random() - 0.5) * 60 * 60 * 1000; // من -30 لـ +30 دقيقة
        var flowTime = mcqTime + twoHoursMs + randomVariation;

        // إضافة الاختبار المعرفي للطابور
        queue.push({ id: student.id, phase: "mcq_pre", time: mcqTime, done: false });
        
        // إضافة مقياس التدفق للطابور
        queue.push({ id: student.id, phase: "flow_pre", time: flowTime, done: false });
    }

    // ترتيب الطابور زمنياً من الأقدم للأحدث
    queue.sort(function(a, b) { return a.time - b.time; });

    // حفظ الطابور باستخدام safeSetProperty (الموجودة في main.js) لتتحمل الحجم الكبير
    safeSetProperty(PropertiesService.getScriptProperties(), 'SMART_QUEUE', JSON.stringify(queue));

    // تفعيل المؤقت ليعمل كل 5 دقائق
    startTrigger5Mins();

    Logger.log("✅ تم بناء الطابور القبلي لـ " + students.length + " طالب (إجمالي " + queue.length + " مهمة).");
    Logger.log("⏱️ السكربت سيعمل تلقائياً كل 5 دقائق ليرسل الردود التي حان وقتها.");
}

/**
 * 📅 2. بناء وجدولة الطابور للاختبار البعدي (مع استبعاد الـ 16 طالباً)
 */
function buildQueue_PostTest() {
    var data = loadSimulationData();
    var students = data.students;
    var queue = [];
    var now = new Date().getTime();
    var windowMs = 48 * 60 * 60 * 1000; 

    // قائمة الـ 16 طالباً الذين تسربوا (كما اتفقنا في النقطة السابقة)
    var droppedOutStudents = [
        "STD-081", "STD-082", "STD-083", "STD-084",
        "STD-085", "STD-086", "STD-087", "STD-088",
        "STD-089", "STD-090", "STD-091", "STD-092",
        "STD-093", "STD-094", "STD-095", "STD-096"
    ];

    for (var i = 0; i < students.length; i++) {
        var student = students[i];

        // ⚠️ إذا كان الطالب من ضمن المتسربين، لا تضعه في طابور البعدي
        if (droppedOutStudents.indexOf(student.id) !== -1) continue;

        var mcqTime = now + (Math.random() * windowMs);
        var twoHoursMs = 2 * 60 * 60 * 1000;
        var randomVariation = (Math.random() - 0.5) * 60 * 60 * 1000;
        var flowTime = mcqTime + twoHoursMs + randomVariation;

        queue.push({ id: student.id, phase: "mcq_post", time: mcqTime, done: false });
        queue.push({ id: student.id, phase: "flow_post", time: flowTime, done: false });
    }

    queue.sort(function(a, b) { return a.time - b.time; });
    safeSetProperty(PropertiesService.getScriptProperties(), 'SMART_QUEUE', JSON.stringify(queue));
    
    startTrigger5Mins();

    Logger.log("✅ تم بناء الطابور البعدي. تم استبعاد 16 طالباً (تسرب). المتبقي 80 طالباً.");
}

/**
 * ⚙️ 3. المحرك الذي يشتغل كل 5 دقائق ويرسل الردود (Processor)
 */
function processSmartQueue() {
    var props = PropertiesService.getScriptProperties();
    var queueStr = safeGetProperty(props, 'SMART_QUEUE');
    if (!queueStr) return;

    var queue = JSON.parse(queueStr);
    var now = new Date().getTime();
    var data = loadSimulationData();
    var students = data.students;

    var mcqForm = FormApp.openByUrl(MCQ_FORM_URL);
    var flowForm = FormApp.openByUrl(FLOW_FORM_URL);

    var processedCount = 0;

    for (var i = 0; i < queue.length; i++) {
        var item = queue[i];

        // إذا أُنجزت المهمة، أو لم يحن وقتها بعد -> تخطاها
        if (item.done || item.time > now) continue;

        // إيجاد بيانات الطالب من الجيسون
        var studentData = null;
        for (var j=0; j<students.length; j++) {
            if (students[j].id === item.id) { studentData = students[j]; break; }
        }

        if (studentData) {
            try {
                if (item.phase.indexOf("mcq") > -1) {
                    var testPhase = item.phase.replace("mcq_", "");
                    submitMCQResponse(mcqForm, studentData, testPhase);
                } else {
                    var testPhase = item.phase.replace("flow_", "");
                    submitFlowResponse(flowForm, studentData, testPhase);
                }
                
                Logger.log("✅ أُرسل: " + item.id + " | " + item.phase);
                item.done = true;
                processedCount++;

            } catch (e) {
                Logger.log("❌ خطأ مع الطالب " + item.id + ": " + e.message);
            }
        }

        // إرسال 3 ردود كحد أقصى في كل تشغيلة (لتبدو بشرية 100% ولتجنب حظر جوجل)
        if (processedCount >= 3) break;
    }

    // حفظ الطابور بعد التحديث
    safeSetProperty(props, 'SMART_QUEUE', JSON.stringify(queue));

    // فحص هل انتهينا من كل الطابور؟
    var remaining = queue.filter(function(q) { return !q.done; }).length;
    if (remaining === 0) {
        cleanUpAllTriggers();
        Logger.log("🎉 اكتمل إرسال جميع الردود في هذا الطابور!");
    } else if (processedCount > 0) {
        Logger.log("⏳ متبقي في الطابور: " + remaining + " مهمة.");
    }
}

/**
 * ⏱️ 4. دوال مساعدة للـ Triggers
 */
function startTrigger5Mins() {
    cleanUpAllTriggers();
    ScriptApp.newTrigger('processSmartQueue')
             .timeBased()
             .everyMinutes(5)
             .create();
}

function cleanUpAllTriggers() {
    var triggers = ScriptApp.getProjectTriggers();
    for (var i = 0; i < triggers.length; i++) {
        if (triggers[i].getHandlerFunction() === 'processSmartQueue') {
            ScriptApp.deleteTrigger(triggers[i]);
        }
    }
}
