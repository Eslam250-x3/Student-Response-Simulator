/**
 * 🚀 الدالة الرئيسية لتوليد شيت درجات المهام الـ 5
 */
function generateProjectGradebook() {
  var students = getStudents(); // جلب الـ 96 طالب (بما فيهم الـ 16 متسرب)
  
  // المتسربون (4 من كل مجموعة)
  var dropouts = [
    "STD-081", "STD-082", "STD-083", "STD-084",
    "STD-085", "STD-086", "STD-087", "STD-088",
    "STD-089", "STD-090", "STD-091", "STD-092",
    "STD-093", "STD-094", "STD-095", "STD-096"
  ];

  // إعداد تاريخ بدء التجربة افتراضياً (مثلاً منذ 25 يوماً من اليوم ليكون واقعياً)
  var startDate = new Date();
  startDate.setDate(startDate.getDate() - 25);
  
  var gradebook = [];

  // تقسيم المجموعات التعاونية (G3, G4) إلى فرق (Teams)
  // كل مجموعة بها 24 طالب -> نقسمهم لـ 6 فرق، كل فريق 4 طلاب
  var teams = { "G3": {}, "G4": {} };
  var teamCounters = { "G3": 1, "G4": 1 };
  var currentTeamIds = { "G3": 1, "G4": 1 };

  for (var i = 0; i < students.length; i++) {
    var s = students[i];
    var isDropout = dropouts.indexOf(s.id) !== -1;
    var group = s.group;
    
    // --- 1. تحديد طبيعة العمل (فردي أم جماعي) ---
    var teamName = "عمل فردي";
    if (group === "G3" || group === "G4") {
      teamName = "فريق " + currentTeamIds[group];
      if (!teams[group][teamName]) {
        teams[group][teamName] = generateTeamScores(isDropout); // توليد درجات موحدة للفريق
      }
      teamCounters[group]++;
      if (teamCounters[group] > 4) { // كل 4 طلاب يمثلون فريق
        teamCounters[group] = 1;
        currentTeamIds[group]++;
      }
    }

    // --- 2. جلب وتوليد الدرجات ---
    var scores;
    if (group === "G3" || group === "G4") {
      scores = teams[group][teamName]; // التشاركي يأخذون نفس درجة الفريق
    } else {
      scores = generateTeamScores(isDropout); // التنافسي يأخذون درجات فردية
    }

    // --- 3. توليد تواريخ التسليم بناءً على الضغط الزمني ---
    var timestamps = generateTimestamps(group, startDate, isDropout);

    // --- 4. تجميع بيانات الطالب في صف ---
    var totalScore = scores.M1 + scores.M2 + scores.M3 + scores.M4 + scores.M5 + scores.Bonus;
    
    gradebook.push([
      s.id, s.name, group, teamName,
      scores.M1, timestamps.T1,
      scores.M2, timestamps.T2,
      scores.M3, timestamps.T3,
      scores.M4, timestamps.T4,
      scores.M5, timestamps.T5,
      scores.Bonus, totalScore
    ]);
  }

  // --- 5. تصدير البيانات إلى شيت جوجل ---
  exportGradebookToSheet(gradebook);
}

/**
 * 🎲 توليد درجات للمهام (تحاكي الواقع والانسحاب)
 */
function generateTeamScores(isDropout) {
  // الدرجات العظمى: M1(10), M2(20), M3(30), M4(15), M5(20), Bonus(5)
  if (isDropout) {
    // المتسرب يحل أول مهمتين ثم يأخذ أصفاراً
    return {
      M1: Math.floor(Math.random() * 4) + 5, // 5 إلى 8
      M2: Math.floor(Math.random() * 8) + 10, // 10 إلى 17
      M3: 0, M4: 0, M5: 0, Bonus: 0
    };
  } else {
    // الطالب الملتزم يأخذ درجات جيدة إلى ممتازة
    return {
      M1: Math.floor(Math.random() * 3) + 8,   // 8 إلى 10
      M2: Math.floor(Math.random() * 5) + 15,  // 15 إلى 20
      M3: Math.floor(Math.random() * 8) + 22,  // 22 إلى 30
      M4: Math.floor(Math.random() * 4) + 11,  // 11 إلى 15
      M5: Math.floor(Math.random() * 5) + 15,  // 15 إلى 20
      Bonus: Math.random() > 0.7 ? 5 : 0       // 30% فرصة للـ بونص
    };
  }
}

/**
 * ⏰ توليد تواريخ تسليم المهام (Timestamps) لتناسب كل مجموعة
 */
function generateTimestamps(group, startDate, isDropout) {
  var t1="", t2="", t3="", t4="", t5="";
  var startMs = startDate.getTime();
  var dayMs = 24 * 60 * 60 * 1000;

  // دالة مساعدة لتوليد تاريخ عشوائي حول يوم معين (تجنب أوقات الفجر)
  function getSubmitDate(targetDayOffset) {
    var d = new Date(startMs + (targetDayOffset * dayMs));
    d.setHours(14 + Math.floor(Math.random() * 9), Math.floor(Math.random() * 60)); // بين 2 ظهراً و 11 مساءً
    return Utilities.formatDate(d, "Africa/Cairo", "yyyy-MM-dd HH:mm");
  }

  if (group === "G2" || group === "G4") {
    // ⚠️ ضغط زمني (مواعيد صارمة موزعة على الأيام)
    var d1 = (group==="G2")? 3 : 4; 
    var d2 = (group==="G2")? 8 : 9;
    var d3 = (group==="G2")? 14 : 15;
    var d4 = (group==="G2")? 17 : 18;
    var d5 = 21;

    t1 = getSubmitDate(d1 - Math.random()); // تسليم قبل الموعد بيوم أو ساعات
    t2 = getSubmitDate(d2 - Math.random());
    if(!isDropout) t3 = getSubmitDate(d3 - Math.random());
    if(!isDropout) t4 = getSubmitDate(d4 - Math.random());
    if(!isDropout) t5 = getSubmitDate(d5 - Math.random());
  } 
  else {
    // 🌿 مرونة زمنية (G1, G3) - كل التسليمات تكون قريبة من اليوم 20 و 21
    t1 = getSubmitDate(18 + Math.random());
    t2 = getSubmitDate(19 + Math.random());
    if(!isDropout) t3 = getSubmitDate(20 + Math.random());
    if(!isDropout) t4 = getSubmitDate(20.5 + Math.random());
    if(!isDropout) t5 = getSubmitDate(21 - Math.random());
  }

  if(isDropout){
     t3 = "لم يتم التسليم";
     t4 = "لم يتم التسليم";
     t5 = "لم يتم التسليم";
  }

  return { T1: t1, T2: t2, T3: t3, T4: t4, T5: t5 };
}

/**
 * 📊 تصدير الدفتر إلى Google Sheet
 */
function exportGradebookToSheet(gradebookRows) {
  var ss = SpreadsheetApp.create("سجل درجات مهام حشد المصادر (21 يوماً)");
  var sheet = ss.getActiveSheet();
  sheet.setName("سجل المهام والتقييم");

  var headers = [
    "كود الطالب", "اسم الطالب", "المجموعة", "الفريق (للتشاركي)",
    "المهمة 1 (10)", "وقت تسليم م1",
    "المهمة 2 (20)", "وقت تسليم م2",
    "المهمة 3 (30)", "وقت تسليم م3",
    "المهمة 4 (15)", "وقت تسليم م4",
    "المهمة 5 (20)", "وقت تسليم م5",
    "بونص (5)", "المجموع النهائي (100)"
  ];

  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  sheet.getRange(2, 1, gradebookRows.length, headers[0].length).setValues(gradebookRows);
  
  // تنسيق
  sheet.getRange(1, 1, 1, headers.length).setFontWeight("bold").setBackground("#4a86c8").setFontColor("white");
  sheet.setFrozenRows(1);
  
  Logger.log("✅ تم إنشاء شيت سجل متابعة المهام بنجاح!");
  Logger.log("🔗 الرابط: " + ss.getUrl());
}
