                    item.done = true; 
                }
            }
        } else {
             // لو الطالب مش موجود في الجيسون لأي سبب، تجاهله
             item.done = true;
        }

        processedCount++;
        if (processedCount >= 3) break; // 3 ردود كحد أقصى لتجنب الحظر
    }

    safeSetProperty(props, 'SMART_QUEUE', JSON.stringify(queue));

    var remaining = queue.filter(function(q) { return !q.done; }).length;
    if (remaining === 0) {
        cleanUpAllTriggers();
        Logger.log("🎉 اكتمل إرسال جميع الردود بنجاح تام!");
    } else if (processedCount > 0) {
        Logger.log("⏳ متبقي في الطابور: " + remaining + " مهمة.");
    }
}
