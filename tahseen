START_DATE = datetime.now() - timedelta(days=25)

DROPOUTS = [
    "STD-081", "STD-082", "STD-083", "STD-084",
    "STD-085", "STD-086", "STD-087", "STD-088",
    "STD-089", "STD-090", "STD-091", "STD-092",
    "STD-093", "STD-094", "STD-095", "STD-096"
]

DEADLINES = {"G2": [3, 8, 14, 17, 21], "G4": [4, 9, 15, 18, 21]}
MAX_SCORES = [10, 20, 30, 15, 20]

def get_learning_curve_skill(pre_skill, post_skill, task_index):
    """
    🎯 منحنى التعلم: 
    المهمة 1 تعتمد بنسبة 100% على القبلي.
    المهمة 5 تعتمد بنسبة 100% على البعدي.
    ما بينهما تدرج ونمو!
    """
    progress_ratio = task_index / 4.0 # 0, 0.25, 0.5, 0.75, 1.0
    current_skill = pre_skill + (post_skill - pre_skill) * progress_ratio
    return current_skill

def generate_anchored_score(max_score, is_dropout, group, current_skill):
    """توليد درجة تعتمد على المهارة اللحظية (حسب منحنى التعلم)"""
    if is_dropout: return int(max_score * random.uniform(0.3, 0.5))

    actual_perf = current_skill + random.gauss(0, 0.05)
    
    # تأثير بيئة العمل
    if group == "G3": actual_perf += 0.05
    elif group == "G2": actual_perf -= 0.05
    
    actual_perf = max(0.1, min(1.0, actual_perf))
    return int(round(actual_perf * max_score))

def apply_late_penalty(score, delay_hours):
    if delay_hours <= 0: return score
    if 0 < delay_hours <= 6: return int(score * 0.70)
    if 6 < delay_hours <= 24: return int(score * 0.40)
    return 0

def generate_anchored_timestamp(group, task_index, is_dropout, student_flow):
