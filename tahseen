 * 🌞 دالة مساعدة: توليد وقت عشوائي في ساعات النهار فقط (من 9 صباحاً لـ 10 مساءً)
 */
function getRandomDaytimeMs(baseDate, daysWindow) {
    var d = new Date(baseDate);
    // اختيار يوم عشوائي (اليوم، غداً، أو بعد غد)
    var randomDayOffset = Math.floor(Math.random() * daysWindow);
    d.setDate(d.getDate() + randomDayOffset);
    
    // اختيار ساعة عشوائية بين 9 صباحاً و 21 (9 مساءً)
    var randomHour = 9 + Math.floor(Math.random() * 12);
    var randomMin = Math.floor(Math.random() * 60);
    
    d.setHours(randomHour, randomMin, 0, 0);
    return d.getTime();
}

